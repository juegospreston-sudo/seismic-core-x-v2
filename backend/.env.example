# Clave API de Brevo para enviar alertas sísmicas.
# Créala en el panel de Brevo; nunca subas el valor real al repositorio.
BREVO_API_KEY=your_brevo_api_key

# Destinatarios separados por comas.
ALERTAS_EMAILS=alerts@example.com

# Esta dirección debe estar verificada en Brevo.
ALERTAS_SENDER_EMAIL=verified-sender@example.com
ALERTAS_SENDER_NAME=MONITOR SÍSMICO
